# ===========================================================================
# Multilingual file for the TOS 7 Docker application "chromadbdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "ChromaDB"
auth         = "chroma-core"
version      = "@@VERSION@@"
descript     = "ChromaDB is an open-source embedding database: store vectors with metadata and documents, query by similarity and filter by metadata - the storage layer behind RAG assistants and semantic search. It serves HTTP API v2 on one port, keeps collections in the application data folder, needs no external database, and ships an interactive API console at /docs/."
release_note = "1.5.9-1: remediation of the App Center review (C3/C4/C5/C6/C7/C8/C10/T1/F7/S11). Upgraded from 0.6.3 to ChromaDB 1.5.9 (current upstream release), replacing the unmaintained 0.6.x image that the CVE scan flagged. Adds PRIVACY.md, NOTICE.md and a complete README; anonymized telemetry is off and disclosed; the API console at /docs/ is what App Center opens; the container runs non-root with a read-only root filesystem and no capabilities."
important    = "Requires DockerEngine (installed automatically if missing). Open http://<NAS-IP>:8141/docs/ for the interactive API console; the API is on the same port (/api/v2, health check /api/v2/heartbeat). There is NO authentication: keep it on your LAN or put TLS and auth in front before exposing it. Collections and indexes stay in DockerAppData/chromadbdocker/data. Upstream telemetry is disabled in this package."

[zh-cn]
name         = "ChromaDB"
auth         = "chroma-core"
version      = "@@VERSION@@"
descript     = "ChromaDB 是一个开源的向量数据库：保存向量、元数据与文档，按相似度检索并按元数据过滤，是 RAG 助手与语义搜索的存储层。它在一个端口上提供 HTTP API v2，集合保存在应用数据目录，无需外部数据库，并自带一个可交互的 API 控制台（/docs/）。"
release_note = "1.5.9-1：针对上轮审核意见的整改（C3/C4/C5/C6/C7/C8/C10/T1/F7/S11）。从 0.6.3 升级到 ChromaDB 1.5.9，消除旧镜像中的高危/严重 CVE；新增 PRIVACY.md、NOTICE.md 与完整 README；遥测已关闭并如实披露；应用中心打开的是 /docs/ API 控制台；容器以非 root、只读根文件系统、无 capability 运行。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。浏览器打开 http://<NAS-IP>:8141/docs/ 即为可交互的 API 控制台，API 在同一端口（/api/v2，健康检查 /api/v2/heartbeat）。默认没有任何鉴权——请只在内网使用，暴露到公网前加 TLS 与反向代理鉴权。集合与索引保存在 DockerAppData/chromadbdocker/data。本包已关闭上游遥测。"

[zh-hk]
name         = "ChromaDB"
auth         = "chroma-core"
version      = "@@VERSION@@"
descript     = "ChromaDB 是一個開源的向量資料庫：保存向量、中繼資料與文件，按相似度檢索並按中繼資料過濾，是 RAG 助手與語義搜尋的存儲層。它在一個端口上提供 HTTP API v2，集合保存在應用資料目錄，無需外部資料庫，並自帶一個可互動的 API 控制台（/docs/）。"
release_note = "1.5.9-1：針對上輪審核意見的整改（C3/C4/C5/C6/C7/C8/C10/T1/F7/S11）。從 0.6.3 升級到 ChromaDB 1.5.9，消除舊鏡像中的高危/嚴重 CVE；新增 PRIVACY.md、NOTICE.md 與完整 README；遙測已關閉並如實披露；應用中心打開的是 /docs/ API 控制台；容器以非 root、唯讀根檔案系統、無 capability 運行。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。瀏覽器打開 http://<NAS-IP>:8141/docs/ 即為可互動的 API 控制台，API 在同一端口（/api/v2，健康檢查 /api/v2/heartbeat）。預設沒有任何鑑權——請只在內網使用，公開到互聯網前加 TLS 與反向代理鑑權。集合與索引保存在 DockerAppData/chromadbdocker/data。本包已關閉上游遙測。"

